# Copy to .env (worker/.env for local runs). Never commit real values.

# --- App ---
APP_ENV=
TZ=
LOG_LEVEL=

# --- Database (Supabase) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Anthropic) ---
# Model ids and the cutoff are the only non-secret defaults shown here (same as the code defaults).
ANTHROPIC_API_KEY=
AI_MODEL_TAGGER=claude-haiku-5-5
AI_MODEL_ANALYST=claude-sonnet-5-5
AI_MODEL_RESEARCHER=claude-haiku-5-5
AI_MODEL_NOVELTY=claude-haiku-5-5
AI_MODEL_BULL=claude-haiku-5-5
AI_MODEL_BEAR=claude-haiku-5-5
AI_MODEL_JUDGE=claude-sonnet-5-5
AI_MODEL_POSTMORTEM=claude-haiku-5-5
AI_MODEL_RESULTS_FALLBACK=claude-haiku-5-5
AI_ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5
AI_MULTI_AGENT_MAX_PER_DAY=
AI_SINGLE_ANALYST_MAX_PER_DAY=
KG_MAX_PANEL_SLOTS=
AI_TAGGER_RESERVE_INR=
AI_MODEL_KNOWLEDGE_CUTOFF=2026-06-30
AI_DAILY_BUDGET_INR=
AI_MONTHLY_BUDGET_INR=
RESEARCH_AGENT_PRESET=

# --- Broker (market data only; no order placement) ---
BROKER=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_CLIENT_ID=
BROKER_ACCESS_TOKEN=
BROKER_TOTP_SECRET=
BROKER_TOKEN_ISSUED_ON=

# --- Market / macro data ---
MACRO_PROVIDER=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_BASE_URL=

# --- Schedules and thresholds ---
NEWS_POLL_MIN=
OPTION_POLL_ACTIVE_MIN=
SIGNAL_SCORE_THRESHOLD=
JOB_FAILURE_ALERT_THRESHOLD=

# --- Engine (DESIGN_V2) ---
RISK_FREE_RATE=
EDGE_RATIO_MIN=
MC_PATHS=
SCENARIO_SHRINK_WEIGHT=
LOTS_PER_SIGNAL=
PARTIAL_BOOKING_MODE=

# --- History store (DuckDB + Parquet on the worker VM) ---
HISTORY_DATA_DIR=
DUCKDB_PATH=
GDELT_ENABLED=
ANALOGUE_PRIOR_N=
ANALOGUE_MIN_N=
CALIBRATION_MIN_RECORDS=
CALIBRATION_ISOTONIC_MIN=

# --- Optional Cloudflare R2 backup of history (off unless R2_BACKUP_ENABLED=true) ---
R2_BACKUP_ENABLED=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# --- Dashboard (Vercel, Phase 4) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DASHBOARD_ALLOWED_EMAIL=
MORNING_BRIEF_ENABLED=
EVENING_SUMMARY_ENABLED=

# --- Phase 10: learning-loop PRs, external heartbeat ---
GITHUB_TOKEN_CONFIG_PR=
GITHUB_CONFIG_REPO=
HEALTHCHECK_PING_URL=

# --- Phase 11: optional proxy for NSE requests only ---
NSE_HTTP_PROXY=
